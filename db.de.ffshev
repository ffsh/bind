;
; BIND data file for local loopback interface
;
$TTL    900
$ORIGIN ffshev.de.
@       IN      SOA     ns3.nsentry.de. info.ffshev.de. (
                     2026051900         ; Serial
                          28800         ; Refresh
                           7200         ; Retry
                         604800         ; Expire
                            900 )       ; Negative Cache TTL

@                       IN      NS      ns1.jebens.it.
                        IN      NS      feuerschiff.leichsenring.net.
                        IN      NS      ns2.wollgast-it.de.

;; Domain no longer operated here.
;; Keep only authority metadata to avoid serving stale technical data.
