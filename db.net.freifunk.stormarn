;
; BIND data file for local loopback interface
;
$TTL    900
$ORIGIN stormarn.freifunk.net.
@       IN      SOA     ns3.nsentry.de. info.stormarn.freifunk.net. (
                     2026051900         ; Serial
                          28800         ; Refresh
                           7200         ; Retry
                         604800         ; Expire
                            900 )       ; Negative Cache TTL

@                       IN      NS      ns3.nsentry.de.
                        IN      NS      ns4.nsentry.de.
                        IN      MX      10 mail.freifunk-suedholstein.de.
                        IN      A       116.203.27.68
                        IN      AAAA    2a01:4f8:c2c:143e::1
www                     IN      A       116.203.27.68
                        IN      AAAA    2a01:4f8:c2c:143e::1


;; NTP Service
ntp                     IN      CNAME   ntp.freifunk-suedholstein.de.

;; Knoten
knoten                  IN      CNAME   knoten.freifunk-suedholstein.de.
node                    CNAME           knoten.freifunk-suedholstein.de.
next                    CNAME           knoten.freifunk-suedholstein.de.
router                  CNAME           knoten.freifunk-suedholstein.de.

;; Honeypot -----------------------------------------------
firmware                IN      CNAME   firmware.freifunk-suedholstein.de.
update                  IN      CNAME   firmware.freifunk-suedholstein.de.
gluon                   IN      CNAME   firmware.freifunk-suedholstein.de.

;; Gateways
beste                   IN      A       159.69.122.154
bille                   IN      A       5.181.50.231
trave                   IN      A       88.99.86.15
brunsbach               IN      A       159.69.251.9
